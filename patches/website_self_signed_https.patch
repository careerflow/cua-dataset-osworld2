+    # Hosted benchmark apps use self-signed certificates.  A normal
+    # certificate-verifying probe incorrectly treats a healthy HTTPS app as
+    # unavailable, falls back to HTTP, and can turn a state PUT into a redirect
+    # where the payload is not preserved.  The stateful setup calls already use
+    # ``verify=False``; the scheme probe must match.
+    #
+    # The probe is also retried with a generous timeout: this result is cached
+    # for the whole process, so one slow first response would otherwise send an
+    # entire run to HTTP and fail every stateful setup in it.
+    last_error: Optional[Exception] = None
+    for timeout in (10, 20):
+        try:
+            response = requests.get(
+                https_url, timeout=timeout, allow_redirects=False, stream=True, verify=False,
+            )
+            response.close()
+            logger.info("Using HTTPS for %s", host)
+            return "https://"
+        except requests.RequestException as exc:
+            last_error = exc
+            logger.info("HTTPS probe for %s failed at timeout=%ss: %s", host, timeout, exc)
+    logger.warning("HTTPS unavailable for %s, falling back to HTTP: %s", host, last_error)
+    return "http://"
 
 
